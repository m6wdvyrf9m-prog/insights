# Required in production. Generate with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=""

# Required in production. Use at least 32 random characters:
# python - <<'PY'
# import secrets; print(secrets.token_urlsafe(32))
# PY
SECRET_KEY=""

# Public base URL used when admin pages display participant links.
APP_BASE_URL="https://your-insights-app.example.com"

# For HTTPS deployments set true so session cookies are Secure.
APP_SECURE_COOKIES="true"

# SQLite persistence. Mount this path on durable storage in production.
DATABASE_PATH="instance/insights.sqlite3"
UPLOAD_DIR="instance/uploads"
INSIGHTS_DATA_DIR="instance"

# Upload/session controls.
MAX_UPLOAD_BYTES="20971520"
SESSION_HOURS="12"
